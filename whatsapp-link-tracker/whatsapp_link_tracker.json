      "name": "Webhook Clics Cloudflare",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        1640
      ],
      "webhookId": "8bdf26c2-7c33-4531-86b4-765718c84570"
    },
    {
      "parameters": {
        "jsCode": "// ===== CONFIGURACIÓN =====\nconst CLAVE_CLOUDFLARE = 'CAMBIAR_ESTA_CLAVE_CF';  // la misma que el secreto N8N_CLAVE del Worker\n\nconst req = $input.first().json;\nif ((req.headers || {})['x-clave'] !== CLAVE_CLOUDFLARE) {\n  // Al fallar, el Worker conserva los clics y los reintenta\n  throw new Error('Clave de Cloudflare incorrecta');\n}\n\nconst clics = Array.isArray((req.body || {}).clics) ? req.body.clics : [];\nreturn clics.map(c => ({ json: c }));\n"
      },
