      "id": "ff3e337e-d73a-4373-94a0-349fdd84ad14",
      "name": "Buscar Enlace",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// ===== CONFIGURACIÓN =====\nconst DESTINO_SI_NO_EXISTE = 'https://www.whatsapp.com';  // a dónde mandar si el slug no existe\nconst AGREGAR_REFERENCIA = true;  // agrega \"(ref: slug)\" al mensaje para saber el origen dentro del chat\n\nconst req = $('Webhook Redireccion').first().json;\nconst headers = req.headers || {};\nconst query = req.query || {};\nconst slugPedido = String((req.params || {}).slug || '').toLowerCase();\n\n// Fila del enlace encontrada en la hoja \"Enlaces\" (vacía si no existe)\nconst enlace = $input.all().map(i => i.json).find(r => String(r.slug || '').toLowerCase() === slugPedido);\n\n// ---------- Dispositivo / sistema / navegador / app de origen ----------\nconst ua = String(headers['user-agent'] || '');\nconst prueba = re => re.test(ua);\n\nconst esBot = prueba(/bot|crawl|spider|slurp|facebookexternalhit|facebookcatalog|WhatsApp\\/|TelegramBot|Twitterbot|Slackbot|LinkedInBot|Discordbot|Pinterest|Googlebot|bingbot|preview|HeadlessChrome|curl|wget|python-requests|axios|node-fetch/i) || !ua;\n\nconst dispositivo =\n  prueba(/iPad|Tablet|PlayBook|Silk/i) || (prueba(/Android/i) && !prueba(/Mobile/i)) ? 'Tablet'\n  : prueba(/Mobi|iPhone|iPod|Android|Windows Phone/i) ? 'Móvil'\n  : 'Escritorio';\n\nconst sistema =\n  prueba(/iPhone|iPad|iPod/i) ? 'iOS'\n  : prueba(/Android/i) ? 'Android'\n  : prueba(/Windows/i) ? 'Windows'\n  : prueba(/CrOS/i) ? 'ChromeOS'\n  : prueba(/Mac OS X|Macintosh/i) ? 'macOS'\n  : prueba(/Linux/i) ? 'Linux'\n  : 'Otro';\n\nconst app_origen =\n  prueba(/Instagram/i) ? 'Instagram'\n  : prueba(/FBAN|FBAV|FB_IAB|FBIOS/i) ? 'Facebook'\n  : prueba(/musical_ly|TikTok|BytedanceWebview|trill/i) ? 'TikTok'\n  : prueba(/LinkedInApp/i) ? 'LinkedIn'\n  : prueba(/Twitter/i) ? 'X / Twitter'\n  : prueba(/Snapchat/i) ? 'Snapchat'\n  : prueba(/Pinterest/i) ? 'Pinterest'\n  : prueba(/Telegram/i) ? 'Telegram'\n  : prueba(/GSA\\//i) ? 'Google App'\n  : 'Navegador';\n\nconst navegador =\n  prueba(/Edg\\//i) ? 'Edge'\n  : prueba(/OPR\\/|Opera/i) ? 'Opera'\n  : prueba(/SamsungBrowser/i) ? 'Samsung Internet'\n  : prueba(/Firefox|FxiOS/i) ? 'Firefox'\n  : prueba(/Chrome|CriOS/i) ? 'Chrome'\n  : prueba(/Safari|AppleWebKit/i) ? 'Safari'\n  : 'Otro';\n\n// ---------- IP (para geolocalizar; NO se guarda en la hoja) ----------\nconst ip = String(headers['cf-connecting-ip'] || headers['x-real-ip'] || headers['x-forwarded-for'] || '')\n  .split(',')[0].trim();\n\n// Identificador anónimo de visitante (hash de IP + navegador) para contar clics únicos\nconst hash = s => { let h = 5381; for (const c of s) h = ((h << 5) + h + c.charCodeAt(0)) >>> 0; return h.toString(36); };\nconst visitante_id = hash(ip + '|' + ua);\n\n// ---------- UTM: los de la URL tienen prioridad sobre los guardados ----------\nconst utm = k => String(query[k] || (enlace && enlace[k]) || '').toLowerCase();\n\n// ---------- Destino de WhatsApp ----------\nlet destino = DESTINO_SI_NO_EXISTE;\nif (enlace) {\n  const ref = query.ref || slugPedido;\n  let mensaje = String(enlace.mensaje || '');\n  if (AGREGAR_REFERENCIA) mensaje = `${mensaje} (ref: ${ref})`.trim();\n  const tel = String(enlace.telefono || '').replace(/\\D/g, '');\n  destino = `https://wa.me/${tel}` + (mensaje ? `?text=${encodeURIComponent(mensaje)}` : '');\n}\n\nreturn [{\n  json: {\n    destino,\n    registrar: Boolean(enlace) && !esBot,\n    fecha: $now.toFormat('yyyy-MM-dd HH:mm:ss'),\n    dia: $now.toFormat('yyyy-MM-dd'),\n    hora: $now.toFormat('HH'),\n    slug: slugPedido,\n    utm_source: utm('utm_source'),\n    utm_medium: utm('utm_medium'),\n    utm_campaign: utm('utm_campaign'),\n    utm_content: utm('utm_content'),\n    ref: String(query.ref || ''),\n    dispositivo,\n    sistema,\n    navegador,\n    app_origen,\n    idioma: String(headers['accept-language'] || '').split(',')[0],\n    referer: String(headers['referer'] || headers['referrer'] || ''),\n    visitante_id,\n    ip,\n    pais_cf: String(headers['cf-ipcountry'] || ''),\n  },\n}];\n"
      },
