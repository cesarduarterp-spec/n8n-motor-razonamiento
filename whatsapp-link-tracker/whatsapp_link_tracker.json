      "id": "5dd75ec2-dd80-4775-99bd-39abdca7e302",
      "name": "Leer Enlaces Existentes",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        560
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// ===== CONFIGURACIÓN =====\nconst CLAVE_ADMIN = 'CAMBIAR_ESTA_CLAVE';      // la misma que pones en el panel\nconst BASE_ENLACES = '';                        // ej: 'https://tu-n8n.com/webhook/wa' (opcional, para devolver el link completo)\n\nconst body = $('Webhook Crear Enlace').first().json.body || {};\nconst existentes = $input.all().map(i => i.json).filter(r => r && r.slug);\n\nconst limpiar = v => String(v ?? '').trim();\nconst slugify = s => limpiar(s).toLowerCase()\n  .normalize('NFD').replace(/[̀-ͯ]/g, '')\n  .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);\n\nconst error = (status, mensaje) => [{ json: { ok: false, status, error: mensaje } }];\n\nif (limpiar(body.clave) !== CLAVE_ADMIN) return error(401, 'Clave incorrecta');\n\nconst slug = slugify(body.slug || body.nombre);\nconst telefono = limpiar(body.telefono).replace(/\\D/g, '');\n\nif (!slug) return error(400, 'Falta el nombre del enlace (slug)');\nif (telefono.length < 8 || telefono.length > 15) {\n  return error(400, 'Teléfono inválido: usa formato internacional sin +, ej: 5491122334455');\n}\nif (existentes.some(r => String(r.slug).toLowerCase() === slug)) {\n  return error(409, `El enlace \"${slug}\" ya existe`);\n}\n\nreturn [{\n  json: {\n    ok: true,\n    status: 201,\n    slug,\n    telefono,\n    mensaje: limpiar(body.mensaje),\n    utm_source: slugify(body.utm_source),\n    utm_medium: slugify(body.utm_medium),\n    utm_campaign: slugify(body.utm_campaign),\n    utm_content: slugify(body.utm_content),\n    descripcion: limpiar(body.descripcion),\n    creado: $now.toFormat('yyyy-MM-dd HH:mm:ss'),\n    enlace: BASE_ENLACES ? `${BASE_ENLACES.replace(/\\/+$/, '')}/${slug}` : '',\n  },\n}];\n"
      },
