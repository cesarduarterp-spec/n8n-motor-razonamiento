    {
      "parameters": {
        "jsCode": "// Une los datos de la visita con la geolocalización por IP (ipwho.is)\nconst visita = $('Analizar Visita').first().json;\nconst geo = $input.first().json || {};\nconst ok = geo.success === true;\n\nreturn [{\n  json: {\n    fecha: visita.fecha,\n    dia: visita.dia,\n    hora: visita.hora,\n    slug: visita.slug,\n    utm_source: visita.utm_source,\n    utm_medium: visita.utm_medium,\n    utm_campaign: visita.utm_campaign,\n    utm_content: visita.utm_content,\n    ref: visita.ref,\n    dispositivo: visita.dispositivo,\n    sistema: visita.sistema,\n    navegador: visita.navegador,\n    app_origen: visita.app_origen,\n    pais: ok ? geo.country : (visita.pais_cf || 'Desconocido'),\n    region: ok ? geo.region : '',\n    ciudad: ok ? geo.city : '',\n    latitud: ok ? geo.latitude : '',\n    longitud: ok ? geo.longitude : '',\n    proveedor_internet: ok && geo.connection ? geo.connection.isp : '',\n    idioma: visita.idioma,\n    referer: visita.referer,\n    visitante_id: visita.visitante_id,\n  },\n}];\n"
      },
