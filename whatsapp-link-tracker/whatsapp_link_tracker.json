    {
      "parameters": {
        "jsCode": "// ===== CONFIGURACIÓN =====\nconst CLAVE_ADMIN = 'CAMBIAR_ESTA_CLAVE';  // la misma que en \"Validar Enlace\" y en el panel\n\nconst q = $('Webhook Estadisticas').first().json.query || {};\nif (String(q.clave || '') !== CLAVE_ADMIN) return [{ json: { ok: false, error: 'Clave incorrecta' } }];\n\nconst filtroSlug = String(q.slug || '').toLowerCase();\nconst desde = String(q.desde || '');   // yyyy-MM-dd\nconst hasta = String(q.hasta || '');   // yyyy-MM-dd\n\nconst enlaces = $('Leer Enlaces').all().map(i => i.json).filter(r => r && r.slug);\nconst clics = $('Leer Clics').all().map(i => i.json).filter(r => r && r.slug)\n  .filter(r => !filtroSlug || String(r.slug).toLowerCase() === filtroSlug)\n  .filter(r => !desde || String(r.dia) >= desde)\n  .filter(r => !hasta || String(r.dia) <= hasta);\n\nconst contar = campo => {\n  const m = {};\n  for (const c of clics) { const k = String(c[campo] || 'Sin dato'); m[k] = (m[k] || 0) + 1; }\n  return Object.entries(m).sort((a, b) => b[1] - a[1]).map(([nombre, total]) => ({ nombre, total }));\n};\nconst unicos = lista => new Set(lista.map(c => c.visitante_id)).size;\n\nconst porEnlace = enlaces.map(e => {\n  const propios = clics.filter(c => String(c.slug).toLowerCase() === String(e.slug).toLowerCase());\n  return {\n    slug: e.slug,\n    telefono: e.telefono,\n    utm_source: e.utm_source,\n    utm_campaign: e.utm_campaign,\n    descripcion: e.descripcion,\n    creado: e.creado,\n    clics: propios.length,\n    unicos: unicos(propios),\n    ultimo_clic: propios.map(c => c.fecha).sort().pop() || '',\n  };\n}).filter(e => !filtroSlug || String(e.slug).toLowerCase() === filtroSlug)\n  .sort((a, b) => b.clics - a.clics);\n\nreturn [{\n  json: {\n    ok: true,\n    total_clics: clics.length,\n    visitantes_unicos: unicos(clics),\n    enlaces: porEnlace,\n    por_fuente: contar('utm_source'),\n    por_campana: contar('utm_campaign'),\n    por_dispositivo: contar('dispositivo'),\n    por_sistema: contar('sistema'),\n    por_app: contar('app_origen'),\n    por_navegador: contar('navegador'),\n    por_pais: contar('pais'),\n    por_ciudad: contar('ciudad'),\n    por_dia: contar('dia').sort((a, b) => a.nombre.localeCompare(b.nombre)),\n    por_hora: contar('hora').sort((a, b) => a.nombre.localeCompare(b.nombre)),\n    ultimos_clics: clics.slice(-25).reverse(),\n  },\n}];\n"
      },
