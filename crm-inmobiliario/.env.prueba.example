# ════════════════════════════════════════════════════════════════════
#  MODO PRUEBA — costo mínimo. Completar los valores marcados con  ← COMPLETAR
#  Generar secretos:  openssl rand -base64 48   /   openssl rand -base64 32
# ════════════════════════════════════════════════════════════════════

# Contraseñas internas (cualquier texto largo; no salen de tu máquina)
CRM_OWNER_PASSWORD=prueba-owner-cambiar
CRM_APP_PASSWORD=prueba-app-cambiar
CRM_SYSTEM_PASSWORD=prueba-system-cambiar
REDIS_PASSWORD=prueba-redis-cambiar

NODE_ENV=production
PORT=3000
# Local: http://localhost:3000 · Con túnel: https://<NGROK_DOMAIN>
PUBLIC_BASE_URL=http://localhost:3000

# Túnel con dirección fija (gratis): cuenta en https://dashboard.ngrok.com
#   → "Your Authtoken" y "Domains" (el plan gratis incluye un dominio fijo *.ngrok-free.app)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=                    # ej.: tu-inmobiliaria.ngrok-free.app (sin https://)

JWT_SECRET=                      # ← COMPLETAR (openssl rand -base64 48)
JWT_ISSUER=crm-inmobiliario
MASTER_ENCRYPTION_KEY=           # ← COMPLETAR (openssl rand -base64 32)

# ── IA ──
# Gemini: API key gratuita en https://aistudio.google.com (plan gratuito con cupo diario).
GEMINI_API_KEY=                  # ← COMPLETAR
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Claude apagado: reclamos/mora se derivan a una persona y no se leen contratos automáticamente.
# Para probarlo: CLAUDE_ENABLED=true + ANTHROPIC_API_KEY (se paga por uso).
CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── WhatsApp (opcional): número de prueba gratuito de Meta for Developers ──
META_APP_SECRET=sin-configurar
META_VERIFY_TOKEN=sin-configurar
META_GRAPH_VERSION=v23.0

TIKTOK_CLIENT_SECRET=
YOUTUBE_API_KEY=

TRUST_PROXY_HOPS=1

# Sin backups a la nube en la prueba (los datos quedan en el volumen local de Docker).
BACKUP_REQUIRED=false

STORAGE_DIR=/var/lib/crm/uploads
