# ── Backups de PostgreSQL con WAL-G (solo los usan los contenedores postgres y pg-backup) ──
# Destino (elegir uno):
WALG_S3_PREFIX=s3://mi-bucket-backups/crm-inmobiliario
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
# AWS_ENDPOINT=https://<minio|r2>   # S3 compatible
# AWS_S3_FORCE_PATH_STYLE=true
# WALG_GS_PREFIX=gs://mi-bucket-backups/crm-inmobiliario
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs.json

# Cifrado del lado del cliente (OBLIGATORIO: sin esto los scripts se niegan a subir nada).
# openssl rand -base64 32   → guardar también FUERA de la plataforma (sin la clave no hay restore).
WALG_LIBSODIUM_KEY=
WALG_LIBSODIUM_KEY_TRANSFORM=base64
# Cifrado adicional en el bucket:
# WALG_S3_SSE=aws:kms
# WALG_S3_SSE_KMS_ID=arn:aws:kms:...

# Política
BACKUP_HOUR_UTC=06          # 03:00 hora Argentina
BACKUP_RETAIN_FULL=14
WALG_DELTA_MAX_STEPS=6      # 1 full + hasta 6 deltas
BACKUP_REQUIRED=true        # false solo en desarrollo
