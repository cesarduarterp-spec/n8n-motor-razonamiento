# ── Infra (docker-compose las usa para armar las URLs) ──
CRM_OWNER_PASSWORD=cambiar-owner
CRM_APP_PASSWORD=cambiar-app
CRM_SYSTEM_PASSWORD=cambiar-system
REDIS_PASSWORD=cambiar-redis

# Fuera de docker-compose definir directamente:
# DATABASE_URL=postgres://crm_app:...@host:5432/crm          (rol con RLS)
# DATABASE_SYSTEM_URL=postgres://crm_system:...@host:5432/crm (rol BYPASSRLS: workers/webhooks)
# DATABASE_OWNER_URL=postgres://crm_owner:...@host:5432/crm   (solo migraciones)
# REDIS_URL=redis://:password@host:6379/0

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://crm.tu-dominio.com.ar

# ── Seguridad ──
# openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=crm-inmobiliario
# openssl rand -base64 32   (AES-256-GCM para secretos por tenant; rotarla requiere re-cifrar tenant_secrets)
MASTER_ENCRYPTION_KEY=

# ── LLMs (globales; cada tenant puede usar las propias con settings.useOwnLlmKeys) ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Debe coincidir con vector(768) del schema; cambiarla requiere migración + re-embeddings.
EMBEDDING_DIMENSIONS=768

# ── Meta: WhatsApp Cloud API, Messenger, Instagram ──
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# ── TikTok / YouTube ──
TIKTOK_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ── Índices (valores por defecto; sobrescribir si cambian los endpoints oficiales) ──
BCRA_API_BASE=https://api.bcra.gob.ar/estadisticas/v3.0/monetarias
BCRA_ICL_VARIABLE_ID=40
INDEC_IPC_SERIES_URL=https://apis.datos.gob.ar/series/api/series/?ids=148.3_INIVELNAL_DICI_M_26&format=json&limit=5000

STORAGE_DIR=/var/lib/crm/uploads
